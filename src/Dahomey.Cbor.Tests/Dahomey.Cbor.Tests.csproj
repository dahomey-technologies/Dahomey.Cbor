<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- Signed with the library's own key so it can be an InternalsVisibleTo friend of it; a
         strong-named assembly cannot grant friend access to an unsigned one. -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>../Dahomey.snk</AssemblyOriginatorKeyFile>
    <!-- Deliberately left in the oblivious nullable context: the generator reads the nullable
         annotations of the types it sees, and the oblivious-nullability tests exist to observe what it
         emits for types that carry none. Do not enable annotations here: it changes the CDDL these
         test types produce, and 6 CDDL tests fail. Use '#nullable enable' per file if one needs it. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
    <!-- CddlGeneratorHarness compiles a snippet in memory so a generator diagnostic can be asserted. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Moq" Version="4.18.3" />
    <PackageReference Include="Nerdbank.Streams" Version="2.9.112" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dahomey.Cbor\Dahomey.Cbor.csproj" />
    <!-- The generator runs over this project so generated and reflection output can be compared.
         ReferenceOutputAssembly is on as well so CddlGeneratorHarness can instantiate the generator
         directly; the analyzer wiring is what matters, and it is unaffected. -->
    <ProjectReference Include="..\Dahomey.Cbor.Generator\Dahomey.Cbor.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
