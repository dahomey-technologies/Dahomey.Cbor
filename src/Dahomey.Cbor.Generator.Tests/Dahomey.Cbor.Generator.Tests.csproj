<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Referenced as an ordinary library, not as an analyzer: these tests drive the generator directly
      through CSharpGeneratorDriver so they can assert on the diagnostics it reports. Running it as an
      analyzer over this project would turn every negative case into a build error instead.
    -->
    <ProjectReference Include="..\Dahomey.Cbor.Generator\Dahomey.Cbor.Generator.csproj" />
    <ProjectReference Include="..\Dahomey.Cbor\Dahomey.Cbor.csproj" />
  </ItemGroup>

</Project>
